{
  "name": "skyteklokke",
  "version": "0.1.0",
  "description": "A precision timer app for competitive shooters and range officers",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.3.28",
    "@react-navigation/stack": "^7.0.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "i18next": "^23.7.0",
    "react": "19.3.0",
    "react-i18next": "^13.5.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "baseline-browser-mapping": "^2.11.34",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3",
    "ws": "^8.22.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx|js)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|expo(nent)?|@expo(nent)?/.*|@expo/vector-icons|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|expo-modules-core)/)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testEnvironment": "node"
  },
  "keywords": [
    "shooting",
    "timer",
    "competition",
    "react-native",
    "expo",
    "norway",
    "skytesport"
  ],
  "author": {
    "name": "Sigurd Nes",
    "email": "sigurdne@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigurdne/skyteklokke.git"
  },
  "bugs": {
    "url": "https://github.com/sigurdne/skyteklokke/issues"
  },
  "homepage": "https://github.com/sigurdne/skyteklokke#readme",
  "private": false
}
